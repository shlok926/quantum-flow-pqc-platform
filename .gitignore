# ==============================================================================
# Quantum Flow Technologies — Post-Quantum Cryptography Platform
# Master Git Ignore Configuration (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets Management
# ------------------------------------------------------------------------------
# Ignore all actual local and production environment files
.env
.env.*
!.env.example

# Credentials, tokens, keys and certificates
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.csr
*.der
id_rsa*
*.keystore
secrets/
credentials.json

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version

# Python profiling and runtime
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/
.hypothesis/

# Coverage reports and test runs
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Tooling (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
apps/web/dist/
apps/web/dist-ssr/
apps/web/build/
.parcel-cache/
.turbo/
.next/
out/

# ------------------------------------------------------------------------------
# 4. Databases & Caching (Local Docker / Native)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
postgres-data/
redis-data/
data/pg/
data/redis/

# ------------------------------------------------------------------------------
# 5. Docker & Container Artifacts
# ------------------------------------------------------------------------------
.docker/
docker-compose.override.yml
*.tar.gz
*.tar

# ------------------------------------------------------------------------------
# 6. Operating System & Local Filesystem
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml

# Vim / Emacs
*.swp
*.swo
*#
.#*

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
tmp/
temp/
*.tmp
*.bak

