# ==============================================================================
# Quantum Flow Technologies — Safe Environment Variable Template (.env.example)
# ==============================================================================
# NOTICE:
# - This template contains safe, local-only default values for development.
# - DO NOT insert real credentials, production secrets, or private API keys here.
# - The existence of these environment variable definitions represents configuration
#   architecture; it does NOT imply that all corresponding authentication, scanning,
#   or cloud features are currently implemented in the codebase.
#
# USAGE:
#   Copy this file to .env for local development:
#   cp .env.example .env (or in PowerShell: Copy-Item .env.example .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Quantum Flow PQC Platform"
API_HOST=127.0.0.1
API_PORT=8000
RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite API Base URL
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Database & Cache Persistence (Local Development Defaults)
# ------------------------------------------------------------------------------
# PostgreSQL connection (Async engine used by FastAPI)
DATABASE_URL=postgresql+asyncpg://quantumflow:quantumflow_secret_dev@localhost:5432/quantumflow_db

# PostgreSQL connection (Sync engine used by Alembic migrations)
DATABASE_URL_SYNC=postgresql://quantumflow:quantumflow_secret_dev@localhost:5432/quantumflow_db

# Redis connection (Worker queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Docker Compose credentials
POSTGRES_USER=quantumflow
POSTGRES_PASSWORD=quantumflow_secret_dev
POSTGRES_DB=quantumflow_db

# ------------------------------------------------------------------------------
# 3. Scanner Safety & Execution Limits (Strict Deny-by-Default Controls)
# ------------------------------------------------------------------------------
# Strict safeguard: when true, only RFC 5737 / RFC 3849 testnet and localhost targets are allowed
ALLOW_TEST_TARGETS_ONLY=true

# SSRF Defense: Allow scanning private networks (RFC 1918 / loopback / link-local)?
# CRITICAL: MUST remain false in all environments except dedicated synthetic test fixtures.
SCAN_ALLOW_PRIVATE_NETWORKS=false

# Socket handshake and read timeout bounds (in seconds)
SCAN_DEFAULT_TIMEOUT_SECONDS=10
SCAN_MAX_TIMEOUT_SECONDS=30

# Maximum allowed HTTP redirects during endpoint inspection
SCAN_MAX_REDIRECTS=3

# Permitted destination TCP ports for TLS inspection (comma-separated list)
SCAN_ALLOWED_PORTS=443,8443

# Maximum concurrent worker scan tasks per worker instance
SCAN_MAX_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 4. Engine & Ruleset Versioning Metadata
# ------------------------------------------------------------------------------
COLLECTOR_VERSION=1.0.0-draft
RISK_RULESET_VERSION=2026.11-draft
