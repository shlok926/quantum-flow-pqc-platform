# ==============================================================================
# Quantum Flow Technologies — Safe Environment Variable Template (.env.example)
# ==============================================================================
# NOTICE:
# - This template contains safe, local-only default values for development.
# - DO NOT insert real credentials, production secrets, or private API keys here.
# - The existence of these environment variable definitions represents planned
#   configuration architecture; it does NOT imply that all corresponding authentication,
#   scanning, or cloud features are currently implemented in the codebase.
#
# USAGE:
#   Copy this file to .env for local development:
#   cp .env.example .env (or in PowerShell: Copy-Item .env.example .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: local, development, staging, production
APP_ENV=local
APP_NAME=quantum-flow-pqc-platform
LOG_LEVEL=INFO

# API Server Bind Configuration
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------------------
# 2. Database & Broker Persistence (Local Development Defaults)
# ------------------------------------------------------------------------------
# PostgreSQL Connection (Local Docker instance)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quantum_flow_dev

# Redis Connection (Celery Broker & Caching)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Authentication & Identity Management (Proposed / OIDC Placeholder)
# ------------------------------------------------------------------------------
# OIDC Provider Discovery URL (Example placeholder only; not a live service)
OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration

# Expected JWT Claims
JWT_ISSUER=quantum-flow-auth
JWT_AUDIENCE=quantum-flow-platform

# ------------------------------------------------------------------------------
# 4. Scanner Safety & Execution Limits (Strict Deny-by-Default Controls)
# ------------------------------------------------------------------------------
# Socket handshake and read timeout bounds (in seconds)
SCAN_DEFAULT_TIMEOUT_SECONDS=10
SCAN_MAX_TIMEOUT_SECONDS=30

# Maximum allowed HTTP redirects during endpoint inspection
SCAN_MAX_REDIRECTS=3

# SSRF Defense: Allow scanning private networks (RFC 1918 / loopback / link-local)?
# CRITICAL: MUST remain false in all environments except dedicated synthetic test fixtures.
SCAN_ALLOW_PRIVATE_NETWORKS=false

# Permitted destination TCP ports for TLS inspection (comma-separated list)
SCAN_ALLOWED_PORTS=443,8443

# Maximum concurrent worker scan tasks per worker instance
SCAN_MAX_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 5. Engine & Ruleset Versioning Metadata
# ------------------------------------------------------------------------------
# Collector implementation version stamped on raw observation envelopes
COLLECTOR_VERSION=1.0.0-draft

# Quantum risk assessment ruleset version used for deterministic scoring
RISK_RULESET_VERSION=2026.11-draft

